            {
                "box": {
                    "code": "History carrierPhase(0);\nHistory carrierFeedback(0);\n\nParam wave(0); // 0=sine, 1=saw, 2=square, 3=triangle\n\nmodulator = in1;\nenvelope = in2;\n\n// FM + feedback\nmodulatorXIndex = modulator * index;\nmodWithFeedback = (modulatorXIndex + carrierFeedback) * 0.5;\n\n// phase accumulation\ncarrierPhase += frequency * ratio / samplerate;\ncarrierPhase = wrap(carrierPhase);\n\n// detune\ncarrierFreq = carrierPhase * twopi;\ncarrierFreqDetuned = carrierFreq + (carrierFreq * (detunePercent / 100));\n\n// ---- waveform generation (phase-based) ----\n\n// normalized phase (0–1)\np = carrierPhase;\n\n// sine (uses radians)\nsine = sin(carrierFreqDetuned + modWithFeedback);\n\n// for non-sine, apply modulation in phase domain\npm = wrap(p + (modWithFeedback / twopi));\n\n// saw\nsaw = (pm * 2) - 1;\n\n// square\nsquare = pm < 0.5 ? 1 : -1;\n\n// triangle\ntriangle = abs((pm * 2) - 1) * 2 - 1;\n\n// ---- waveform selection ----\n\noutWave = sine;\n\nif (wave == 1) { outWave = saw; }\nif (wave == 2) { outWave = square; }\nif (wave == 3) { outWave = triangle; }\n\n// output + feedback\ncarrierOutput = outWave * envelope;\ncarrierFeedback = carrierOutput * feedback;\n\nout = carrierOutput;",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
