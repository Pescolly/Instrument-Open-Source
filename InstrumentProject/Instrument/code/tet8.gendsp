, 			{
				"box" : 				{
					"code" : "output(fund, x){ \r\n\treturn fund * pow(2,(x/16));\r\n}\r\n\r\nfund = in1;\r\n\r\nfor (i = 0; i < 16; i +=1) {\r\n\tresult = output(fund, i);\r\n\tif (i == 0){ \r\n\t\tout1 = result;\r\n\t}\r\n\telse if (i == 1){ \r\n\t\tout2 = result;\r\n\t}\r\n\telse if (i == 2){ \r\n\t\tout3 = result;\r\n\t}\r\n\telse if (i == 3){ \r\n\t\tout4 = result;\r\n\t}\r\n\telse if (i == 4){ \r\n\t\tout5 = result;\t\t\r\n\t}\r\n\telse if (i == 5){ \r\n\t\tout6 = result;\t\t\r\n\t}\r\n\telse if (i == 6){ \r\n\t\tout7 = result;\t\t\r\n\t}\r\n\telse if (i == 7){ \r\n\t\tout8 = result;\t\t\r\n\t}\r\n\telse if (i == 8){ \r\n\t\tout9 = result;\r\n\t}\r\n\telse if (i == 9){ \r\n\t\tout10 = result;\r\n\t}\r\n\telse if (i == 10){ \r\n\t\tout11 = result;\r\n\t}\r\n\telse if (i == 11){ \r\n\t\tout12 = result;\r\n\t}\r\n\telse if (i == 12){ \r\n\t\tout13 = result;\t\t\r\n\t}\r\n\telse if (i == 13){ \r\n\t\tout14 = result;\t\t\r\n\t}\r\n\telse if (i == 14){ \r\n\t\tout15 = result;\t\t\r\n\t}\r\n\telse if (i == 15){ \r\n\t\tout16 = result;\t\t\r\n\t}\r\n}\r\n",
