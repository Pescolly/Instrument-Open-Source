				"box" : 				{
					"code" : "Param freq(0,min=1,max=20000);\r\nParam Q(20,min=0.5,max=100);\r\n\r\n// two-stage delay:\r\nHistory d1(0), d2(0);\r\n\r\n// parameter conversion:\r\nq1 = 1 / Q;\r\nf1 = sin(twopi*freq/samplerate);\r\n// low, high, band & notch:\r\nL = d2 + f1*d1;\r\nH = in1 - L - q1*d1;\r\nB = f1 * H + d1;\r\n// store delay:\r\nd1, d2 = B, L;\r\nH_out = H * 0.5;\r\nout1 = H_out;",
					"fontface" : 0,
					"fontname" : "<Monospaced>",
