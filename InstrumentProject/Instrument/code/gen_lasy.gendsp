            {
                "box": {
                    "code": "History currentState(0);\nHistory prevPhase(0);\n\ntransTableSize = dim(transferTable);\nstateABufferSize = dim(stateABuffer);\nstateBBufferSize = dim(stateBBuffer);\r\nplaybackBufferSize = dim(playbackBuffer);\n\nphase = in1;\nwrapped = phase < prevPhase;\nprevPhase = phase;\n\nif (wrapped) {\n    if (currentState == 0) {\n        for (i = 0; i < playbackBufferSize; i += 1) {\n            valueM1 = peek(stateABuffer, i - 1, boundmode=\"wrap\", interp=\"linear\", index=\"samples\");\n            value   = peek(stateABuffer, i, interp=\"linear\", index=\"samples\");\n            valueP1 = peek(stateABuffer, i + 1, boundmode=\"wrap\", interp=\"linear\", index=\"samples\");\n\n            avg_value = abs(valueM1 * transTableSize + value * transTableSize + valueP1 * transTableSize) / 3;\n            avg_value = clamp(avg_value, 0, transTableSize);\n\n            tTableValue = peek(transferTable, avg_value, boundmode=\"wrap\", index=\"samples\");\n\n            poke(stateBBuffer, tTableValue, i, boundmode=\"wrap\", index=\"samples\");\r\n            poke(playbackBuffer, tTableValue, i, boundmode=\"wrap\", index=\"samples\");\r\n            \n            currentState = 1;\n        }\n    }\n    else if (currentState == 1)\n    {\n        for (i = 0; i < playbackBufferSize; i += 1) {\n            valueM1 = peek(stateBBuffer, i - 1, boundmode = \"wrap\", interp=\"linear\", index=\"samples\");\n            value = peek(stateBBuffer, i, index=\"samples\");\n            valueP1 = peek(stateBBuffer, i + 1, boundmode = \"wrap\", interp=\"linear\", index=\"samples\");\n\n            avg_value = abs(valueM1 * transTableSize + value * transTableSize + valueP1 * transTableSize) / 3;\n            avg_value = clamp(avg_value, 0, transTableSize);\n\n            tTableValue = peek(transferTable, avg_value, boundmode = \"wrap\", index=\"samples\");\n\r\n            poke(stateABuffer, tTableValue, i, boundmode=\"wrap\", index=\"samples\");\r\n            poke(playbackBuffer, tTableValue, i, boundmode=\"wrap\", index=\"samples\");\n\n            currentState = 0;\n        }\n    }\n}\r\n\r\nout1 = peek(playbackBuffer, phase, boundmode = \"wrap\", index = \"phase\");\nout2 = currentState;\r\nout3 = phase;\nout4 = prevPhase;\r\n",
